{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public profile information for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Wallet": {
      "title": "User Wallet",
      "description": "Stores the virtual balance for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "balance": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "balance"]
    },
    "Transaction": {
      "title": "Transaction Record",
      "description": "Record of a transfer between users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["send", "receive", "split"] },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "qrId": { "type": "string" }
      },
      "required": ["id", "amount", "status", "timestamp"]
    },
    "QRCode": {
      "title": "QR Code Data",
      "description": "Data for a generated QR code that can be scanned.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "amount": { "type": "number" },
        "isUsed": { "type": "boolean" },
        "expiry": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderId", "amount", "isUsed"]
    },
    "Token": {
      "title": "Digital Currency Token",
      "description": "A unit of currency that can be transferred between users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "amount": { "type": "number" },
        "isSpent": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "amount", "isSpent"]
    },
    "BankAccount": {
      "title": "Simulation Bank Account",
      "description": "Stores simulated bank details and balance.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "accountNumber": { "type": "string" },
        "ifscCode": { "type": "string" },
        "bankName": { "type": "string" },
        "balance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "accountNumber", "balance"]
    },
    "BankTransaction": {
      "title": "Bank Transaction Record",
      "description": "History of simulated bank movements.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdraw", "wallet_transfer_in", "wallet_transfer_out"] },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "type", "amount", "status", "timestamp"]
    }
  },
  "firestore": {
    "users/{uid}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "wallets/{uid}": {
      "schema": "Wallet",
      "description": "User wallet balance."
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "History of all transactions."
    },
    "qr_codes/{qrId}": {
      "schema": "QRCode",
      "description": "Unused and expired QR codes."
    },
    "tokens/{tokenId}": {
      "schema": "Token",
      "description": "Collection of digital currency tokens."
    },
    "bank_accounts/{uid}": {
      "schema": "BankAccount",
      "description": "User bank account details."
    },
    "bank_transactions/{txId}": {
      "schema": "BankTransaction",
      "description": "History of bank transactions."
    }
  }
}
