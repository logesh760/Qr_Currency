rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
             data.keys().size() <= 5 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.updatedAt is timestamp;
    }

    function isValidWallet(data) {
      return data.keys().hasAll(['uid', 'balance', 'updatedAt']) &&
             data.keys().size() == 3 &&
             data.uid == request.auth.uid &&
             data.balance is number &&
             data.balance >= 0 &&
             data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'amount', 'status', 'timestamp', 'type']) &&
             data.id is string &&
             data.amount is number &&
             data.amount > 0 &&
             data.status in ['pending', 'completed', 'failed'] &&
             data.type in ['send', 'receive', 'split'] &&
             data.timestamp == request.time;
    }

    function isValidQR(data) {
      return data.keys().hasAll(['id', 'senderId', 'amount', 'isUsed', 'createdAt', 'expiry']) &&
             data.id is string &&
             data.senderId == request.auth.uid &&
             data.amount is number &&
             data.amount > 0 &&
             data.isUsed == false &&
             data.createdAt == request.time &&
             data.expiry is timestamp;
    }

    // Match Blocks
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if false; // Prevent scraping all users
      allow create, update: if isOwner(uid) && isValidUser(incoming());
    }

    match /wallets/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && isValidWallet(incoming());
      allow update: if isOwner(uid) && isValidWallet(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'updatedAt']);
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && isValidTransaction(incoming()) && (incoming().senderId == request.auth.uid || incoming().receiverId == request.auth.uid);
    }

    match /qr_codes/{qrId} {
      allow get: if isSignedIn(); 
      allow list: if isSignedIn() && resource.data.senderId == request.auth.uid;
      allow create: if isSignedIn() && isValidQR(incoming());
      allow update: if isSignedIn() && 
                    incoming().isUsed == true && 
                    existing().isUsed == false &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['isUsed']);
    }

    match /tokens/{tokenId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && 
                    incoming().ownerId == request.auth.uid && 
                    incoming().isSpent == false;
      allow update: if isSignedIn() && (
        // Action: Transfer
        (incoming().ownerId != existing().ownerId && incoming().isSpent == false) ||
        // Action: Spend
        (incoming().isSpent == true && existing().isSpent == false)
      );
    }

    match /bank_accounts/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'updatedAt'])
      );
    }

    match /bank_transactions/{txId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
    }
  }
}
